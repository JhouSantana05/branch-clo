# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# -----------------------------------------------------------------------------
# DATABASE CONNECTION (PostgreSQL Serverless - Neon / Supabase Free Tier)
# -----------------------------------------------------------------------------

# Pooler URL: utilizada pela aplicação Next.js na Vercel (PgBouncer pooler na porta 6543 ou Neon pooled endpoint)
# Exemplo Neon: postgresql://[user]:[password]@[neon-hostname]-pooler.us-east-2.aws.neon.tech/[dbname]?sslmode=require
# Exemplo Supabase: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/[dbname]?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/branch_clo?schema=public"

# Direct URL: conexão direta sem pooling (porta 5432), necessária para o Prisma Migrate e Prisma CLI
# Exemplo Neon: postgresql://[user]:[password]@[neon-hostname].us-east-2.aws.neon.tech/[dbname]?sslmode=require
# Exemplo Supabase: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/[dbname]
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/branch_clo?schema=public"

# -----------------------------------------------------------------------------
# APP CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
