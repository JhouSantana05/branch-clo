generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS DE DOMÍNIO
// =============================================================================

enum Role {
  ADMIN
  OPERATOR
  CUSTOMER
}

enum OrderStatus {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_SEPARACAO
  ENVIADO
  ENTREGUE
  CANCELADO
  EM_TROCA
}

enum OrderOrigin {
  ECOMMERCE
  WHATSAPP_MANUAL
}

enum MovementType {
  ENTRADA_FORNECEDOR
  SAIDA_VENDA_ONLINE
  SAIDA_VENDA_MANUAL
  RESERVA_CHECKOUT
  ESTORNO_RESERVA
  RETORNO_TROCA
  AJUSTE_PERDA
}

enum CashCategory {
  RECEITA_VENDAS
  REEMBOLSO_DEVOLUCAO
  FORNECEDOR_PECA
  FRETE_LOGISTICA
  TRAFEGO_PAGO
  EMBALAGENS_TAGS
  PLATAFORMAS_SOFTWARE
}

enum TransactionType {
  ENTRADA
  SAIDA
}

enum ReturnReason {
  TAMANHO_INCORRETO
  ARREPENDIMENTO
  DEFEITO_FABRICACAO
}

enum ReturnStatus {
  SOLICITADO
  ETIQUETA_GERADA
  EM_TRANSITO
  RECEBIDO_AVALIADO
  CONCLUIDO
}

enum ReturnSolution {
  ESTORNO
  VALE_COMPRAS
  TROCA_PECA
}

enum CashStatus {
  PREVISTO
  CONCILIADO
}

// =============================================================================
// MODELOS DE DADOS
// =============================================================================

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  role               Role                @default(OPERATOR)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]

  @@index([email])
}

model Customer {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  phone           String
  cpf             String           @unique
  street          String
  number          String
  complement      String?
  neighborhood    String
  city            String
  state           String
  postalCode      String
  totalSpent      Float            @default(0)
  ordersCount     Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orders          Order[]
  returnExchanges ReturnExchange[]

  @@index([email])
  @@index([cpf])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
}

model Product {
  id                  String           @id @default(cuid())
  name                String
  slug                String           @unique
  description         String?
  fabricComposition   String?
  washingInstructions String?
  categoryId          String
  category            Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  active              Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  images              ProductImage[]
  variants            ProductVariant[]

  @@index([categoryId])
  @@index([slug])
  @@index([active])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  isMain       Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id               String              @id @default(cuid())
  productId        String
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  size             String // ex: PP, P, M, G, GG, U
  colorName        String
  hexColor         String?
  skuCode          String              @unique
  barcode          String?
  costPrice        Float
  regularPrice     Float
  promotionalPrice Float?
  weightGrams      Int
  heightCm         Int
  widthCm          Int
  lengthCm         Int
  stockAvailable   Int                 @default(0)
  stockReserved    Int                 @default(0)
  stockMinAlert    Int                 @default(3)
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  orderItems       OrderItem[]
  movements        InventoryMovement[]
  originReturns    ReturnExchange[]    @relation("OriginVariant")
  targetReturns    ReturnExchange[]    @relation("TargetVariant")

  @@index([productId])
  @@index([skuCode])
  @@index([size])
}

model InventoryMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      MovementType
  quantity  Int
  reason    String
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  @@index([variantId])
  @@index([userId])
  @@index([createdAt])
}

model Order {
  id               String                @id @default(cuid())
  orderNumber      String                @unique // ex: #BC-1001
  customerId       String
  customer         Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  origin           OrderOrigin           @default(ECOMMERCE)
  status           OrderStatus           @default(AGUARDANDO_PAGAMENTO)
  subtotal         Float
  discount         Float                 @default(0)
  couponCode       String?
  shippingCost     Float                 @default(0)
  carrier          String?
  trackingCode     String?
  trackingUrl      String?
  totalAmount      Float
  paymentMethod    String?
  paymentGatewayId String?
  gatewayFee       Float                 @default(0)
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  items            OrderItem[]
  returns          ReturnExchange[]
  transactions     CashFlowTransaction[]

  @@index([customerId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Float
  unitCost  Float

  @@index([orderId])
  @@index([variantId])
}

model ReturnExchange {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  originVariantId String
  originVariant   ProductVariant  @relation("OriginVariant", fields: [originVariantId], references: [id], onDelete: Restrict)
  targetVariantId String?
  targetVariant   ProductVariant? @relation("TargetVariant", fields: [targetVariantId], references: [id], onDelete: SetNull)
  reason          ReturnReason
  status          ReturnStatus    @default(SOLICITADO)
  solution        ReturnSolution
  trackingCode    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

model CashFlowTransaction {
  id             String          @id @default(cuid())
  type           TransactionType
  category       CashCategory
  grossAmount    Float
  feeAmount      Float           @default(0)
  netAmount      Float
  dueDate        DateTime
  settlementDate DateTime?
  status         CashStatus      @default(PREVISTO)
  orderId        String?
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  description    String
  createdAt      DateTime        @default(now())

  @@index([orderId])
  @@index([status])
  @@index([dueDate])
}
